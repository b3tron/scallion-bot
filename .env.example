# Copy this file to .env and fill it in.  NEVER commit .env — it contains secrets.

# ---------- Discord ----------
DISCORD_TOKEN=paste-bot-token-here
# Right-click server icon → Copy Server ID (needs Developer Mode on). Makes slash commands appear instantly.
GUILD_ID=
# Role given after verification. Reuse the role Srihari currently assigns so existing members are unaffected.
VERIFIED_ROLE_ID=
# Optional: a role new members start with, removed after verification.
UNVERIFIED_ROLE_ID=
# Optional: private officer channel where the bot logs every verification.
LOG_CHANNEL_ID=
CLUB_NAME=Assistive Tech

# ---------- Who can verify ----------
ALLOWED_DOMAINS=ucsb.edu
# Addresses that reach the same inbox are treated as one person.
DOMAIN_ALIASES=umail.ucsb.edu:ucsb.edu

# ---------- Limits ----------
CODE_TTL_MINUTES=10
MAX_ATTEMPTS=5
RESEND_COOLDOWN_SECONDS=60
MAX_CODES_PER_HOUR=5

# ---------- Email ----------
# "console" prints codes in the terminal (for testing only). "smtp" sends real email.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=atc.discord.bot@gmail.com
# Gmail: Google Account → Security → 2-Step Verification → App passwords (16 characters, no spaces)
SMTP_PASSWORD=
EMAIL_FROM=atc.discord.bot@gmail.com

# ---------- Storage ----------
DB_PATH=verification.db
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
